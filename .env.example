PORT=8787
HOST=127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
STUDYBUDDY_DATA_DIR=./data
ALLOWED_ORIGINS=*
APP_ATTEST_MODE=enforce
APP_ATTEST_TEAM_ID=S6L62N62M4
APP_ATTEST_BUNDLE_ID=com.smokeys30.studybuddy
APP_ATTEST_ALLOW_DEVELOPMENT=true
# Max protected-API requests per IP per window (OpenAI cost protection).
TUTOR_RATE_LIMIT_MAX=30
TUTOR_RATE_LIMIT_WINDOW_MS=60000

# Daybreak Sentinel is disabled until these credentials are configured.
# Generate independent values; never reuse the OpenAI key or dashboard password.
SECURITY_DATA_DIR=./data/security
SECURITY_INGEST_SECRET=
SECURITY_DASHBOARD_USERNAME=sentinel
SECURITY_DASHBOARD_PASSWORD=
SECURITY_CLOCK_SKEW_SECONDS=300
SECURITY_MAX_EVENTS=500
# AI review runs only when an authenticated dashboard user requests it.
SECURITY_AI_ENABLED=false
SECURITY_AI_MODEL=gpt-5.6-terra
