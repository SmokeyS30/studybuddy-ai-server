<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daybreak.sentinel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Library/Application Support/DaybreakSentinel/daybreak-sentinel-agent.mjs</string>
    <string>--poll</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/var/log/daybreak-sentinel.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/daybreak-sentinel-error.log</string>
</dict>
</plist>
